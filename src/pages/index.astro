---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { categories, categoryUrl } from "../lib/categories";
import { truncate } from "../lib/format";

const articles = (await getCollection("articles"))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

function postUrl(a: typeof articles[0]) {
  return `/${a.data.year}/${a.data.month}/${a.data.day}/${a.data.postSlug}/`;
}

// Track shown article slugs to prevent duplication
const shown = new Set<string>();
function markShown(a: typeof articles[0]) { shown.add(a.data.postSlug); }
function isNew(a: typeof articles[0]) { return !shown.has(a.data.postSlug); }

// 1. Hero: latest article
const hero = articles[0];
if (hero) markShown(hero);

// 2. À la une: articles mis en avant (champ `featured`)
const featured = articles.filter((a) => a.data.featured && isNew(a));
featured.forEach(markShown);

// 3. Category sections: each gets 5 deduped articles from that category
//    (1 en carte principale + 4 dans la liste latérale)
const catArticles = [];
for (const cat of categories) {
  const picked = articles.filter((a) => a.data.categorySlugs.includes(cat.slug) && isNew(a)).slice(0, 5);
  picked.forEach(markShown);
  catArticles.push({ ...cat, articles: picked });
}

// 4. Latest: 8 more articles not shown anywhere
const latest = articles.filter(isNew).slice(0, 8);

// 5. Ce qui reste n'est visible que par les pages de catégorie et l'archive
const rest = articles.filter(isNew).length;
---

<Layout>
  <!-- HERO -->
  {hero && (
    <section class="home-section">
      <div class="hero-card">
        {hero.data.image && <img src={hero.data.image} alt={hero.data.title} />}
        <div class="hero-card-overlay">
          <div class="card-categories">
            {hero.data.categories.map((cat: string, i: number) => (
              <a href={`/category/${hero.data.categorySlugs[i] || cat}/`} class="card-category">{cat}</a>
            ))}
          </div>
          <h2 class="card-title">
            <a href={postUrl(hero)}>{hero.data.title}</a>
          </h2>
          <a href={postUrl(hero)} class="btn-read-more">Lire la suite</a>
        </div>
      </div>
    </section>
  )}

  <!-- À LA UNE -->
  {featured.length > 0 && (
    <section class="home-section">
      <h2 class="section-title">
        À la une
        <a href="/articles/">Tous les articles</a>
      </h2>
      <div class="latest-grid">
        {featured.map((a) => (
          <div class="card">
            {a.data.image && (
              <a href={postUrl(a)}>
                <img src={a.data.image} alt={a.data.title} class="card-image" loading="lazy" />
              </a>
            )}
            <div class="card-body">
              <h3 class="card-title"><a href={postUrl(a)}>{a.data.title}</a></h3>
              {a.data.excerpt && <p class="card-excerpt">{truncate(a.data.excerpt, 110)}</p>}
              <a href={postUrl(a)} class="btn-read-more">Lire la suite</a>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- CATEGORY SECTIONS -->
  {catArticles.map((cat) =>
    cat.articles.length > 0 ? (
      <section class="home-section">
        <h2 class="section-title">
          {cat.name}
          <a href={categoryUrl(cat.slug)}>Tous les articles</a>
        </h2>
        <div class="mixed-block">
          <!-- Main large card -->
          <div class="main-card card">
            {cat.articles[0].data.image && (
              <a href={postUrl(cat.articles[0])}>
                <img src={cat.articles[0].data.image} alt={cat.articles[0].data.title} class="card-image" loading="lazy" />
              </a>
            )}
            <div class="card-body">
              <div class="card-categories">
                {cat.articles[0].data.categories.slice(0, 2).map((c: string, i: number) => (
                  <a href={`/category/${cat.articles[0].data.categorySlugs[i] || c}/`} class="card-category">{c}</a>
                ))}
              </div>
              <h3 class="card-title"><a href={postUrl(cat.articles[0])}>{cat.articles[0].data.title}</a></h3>
            </div>
          </div>
          <!-- Side list -->
          <div class="list-card">
            {cat.articles.slice(1).map((a) => (
              <div class="list-item">
                <a href={postUrl(a)}>{a.data.title}</a>
              </div>
            ))}
          </div>
        </div>
      </section>
    ) : null
  )}

  <!-- LATEST ARTICLES (deduped) -->
  {latest.length > 0 && (
    <section class="home-section">
      <h2 class="section-title">
        Derniers articles
        <a href="/articles/">Tous les articles</a>
      </h2>
      <div class="latest-grid">
        {latest.map((a) => (
          <div class="card">
            {a.data.image && (
              <a href={postUrl(a)}>
                <img src={a.data.image} alt={a.data.title} class="card-image" loading="lazy" />
              </a>
            )}
            <div class="card-body">
              <h3 class="card-title"><a href={postUrl(a)}>{a.data.title}</a></h3>
              {a.data.excerpt && <p class="card-excerpt">{truncate(a.data.excerpt, 110)}</p>}
              <a href={postUrl(a)} class="btn-read-more">Lire la suite</a>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Les articles restants restent accessibles via l'archive et les pages de catégorie -->
  {rest > 0 && (
    <section class="home-section">
      <p class="home-archive-note">
        {rest} autre{rest > 1 ? "s" : ""} article{rest > 1 ? "s" : ""} est{rest > 1 ? "ont" : ""}
        disponible{rest > 1 ? "s" : ""} dans l'archive — <a href="/articles/">voir tous les articles</a>.
      </p>
    </section>
  )}
</Layout>

<style>
  .home-archive-note {
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-muted);
    margin: 0;
  }
  .home-archive-note a {
    color: var(--color-accent-dark);
  }
</style>
