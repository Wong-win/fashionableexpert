---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Page non trouvée (404)" description="La page que vous cherchez n'existe pas.">
  <div class="error-page">
    <h1>404</h1>
    <p class="error-message">Page non trouvée</p>
    <p>Désolé, la page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a href="/" class="error-home-link">← Retour à l'accueil</a>
  </div>
</Layout>

<style>
  .error-page {
    max-width: 560px;
    margin: 80px auto;
    text-align: center;
    padding: 0 24px;
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
    color: var(--color-text, #1a1a1a);
  }
  .error-page h1 {
    font-size: 96px;
    margin: 0 0 8px;
    font-weight: 800;
    letter-spacing: -2px;
  }
  .error-message {
    font-size: 24px;
    margin: 0 0 24px;
    font-weight: 600;
  }
  .error-page p {
    margin: 0 0 32px;
    opacity: 0.7;
  }
  .error-home-link {
    display: inline-block;
    padding: 14px 28px;
    background: var(--color-accent, #111);
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: opacity 0.2s;
  }
  .error-home-link:hover {
    opacity: 0.85;
  }
</style>
