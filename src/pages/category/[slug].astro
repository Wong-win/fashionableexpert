---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { categories, categoryUrl, getCategory } from "../../lib/categories";
import { categoryDescription, truncate } from "../../lib/format";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  const catMap = new Map<string, string>(); // slug → name
  const catCount = new Map<string, number>();

  for (const a of articles) {
    for (let i = 0; i < a.data.categories.length; i++) {
      const cn = a.data.categories[i];
      const cs = a.data.categorySlugs[i] || cn.toLowerCase().replace(/ /g, "-");
      if (!catMap.has(cs)) catMap.set(cs, cn);
      catCount.set(cs, (catCount.get(cs) || 0) + 1);
    }
  }

  return Array.from(catMap.keys()).map((slug) => ({
    params: { slug },
    props: {
      categoryName: catMap.get(slug)!,
      categorySlug: slug,
      count: catCount.get(slug) || 0,
    },
  }));
}

const { categoryName, categorySlug, count } = Astro.props;
const def = getCategory(categorySlug);
const displayName = def?.name ?? categoryName;
const description = def?.description ?? `Articles de la catégorie ${categoryName}.`;
const metaDesc = categoryDescription(description, count);

const articles = (await getCollection("articles"))
  .filter((a) => a.data.categorySlugs.includes(categorySlug) || a.data.categories.includes(categoryName))
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const others = categories.filter((c) => c.slug !== categorySlug);
---

<Layout title={displayName} description={metaDesc}>
  <div class="category-header">
    <h1>{displayName}</h1>
    <p>{count} article{count > 1 ? "s" : ""}</p>
    <p class="category-intro">{description}</p>
  </div>

  <div class="post-grid">
    {articles.map((a) => (
      <div class="card">
        {a.data.image && (
          <a href={`/${a.data.year}/${a.data.month}/${a.data.day}/${a.data.postSlug}/`}>
            <img src={a.data.image} alt={a.data.title} class="card-image" loading="lazy" style="height:200px" />
          </a>
        )}
        <div class="card-body">
          <div class="card-categories">
            {a.data.categories.map((cat: string, i: number) => (
              <a href={`/category/${a.data.categorySlugs[i] || cat.toLowerCase().replace(/ /g, "-")}/`} class="card-category">{cat}</a>
            ))}
          </div>
          <h3 class="card-title">
            <a href={`/${a.data.year}/${a.data.month}/${a.data.day}/${a.data.postSlug}/`}>{a.data.title}</a>
          </h3>
          {a.data.excerpt && <p class="card-excerpt">{truncate(a.data.excerpt, 140)}</p>}
        </div>
      </div>
    ))}
  </div>

  <nav class="category-switch" aria-label="Autres catégories">
    <h2>Autres catégories</h2>
    <ul>
      {others.map((c) => (
        <li><a href={categoryUrl(c.slug)}>{c.name}</a></li>
      ))}
    </ul>
  </nav>
</Layout>

<style>
  .category-intro {
    max-width: 680px;
    margin: 12px auto 0 !important;
    font-size: 0.95rem !important;
    line-height: 1.65;
    color: var(--color-text) !important;
  }
  .category-switch {
    max-width: 1200px;
    margin: 40px auto 60px;
    padding: 24px 20px 0;
    border-top: 1px solid var(--color-border);
  }
  .category-switch h2 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0 0 12px;
    text-align: center;
  }
  .category-switch ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    justify-content: center;
  }
  .category-switch a {
    color: var(--color-accent-dark);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .category-switch a:hover { text-decoration: underline; }
</style>
